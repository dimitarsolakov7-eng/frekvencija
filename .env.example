# Frekvencija environment variables (docs/ARCHITECTURE.md §3).
# Copy to .env.local and fill in. Never commit real values. Read only through src/lib/env.ts.
# NEXT_PUBLIC_* values are inlined into the browser bundle at build time: rebuild after changing them.

# --- Public ----------------------------------------------------------------

# Optional platform display name (default "Frekvencija").
NEXT_PUBLIC_PLATFORM_NAME=

# Public origin of this app, no trailing slash and no path. Used to build auth email links
# (invites, password resets). Required in production; defaults to http://localhost:3000 otherwise.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project URL (Dashboard → Project Settings → API).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase publishable key (sb_publishable_…). Safe for the browser; RLS protects the data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy fallback, used only when the publishable key above is empty (anon JWT, eyJ…).
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Server only (never prefix with NEXT_PUBLIC_) ---------------------------

# Supabase secret key (sb_secret_…). Bypasses RLS. Used only for Auth admin (invites), upload
# validation downloads/cleanup, rate limiting, and (by default) deriving the upload-token key.
SUPABASE_SECRET_KEY=
# Legacy fallback, used only when SUPABASE_SECRET_KEY is empty (service_role JWT, eyJ…).
# SUPABASE_SERVICE_ROLE_KEY=

# Optional. ElevenLabs API key for generating announcements. When empty the admin UI shows
# "Text-to-speech is not configured"; MP3 uploads still work.
ELEVENLABS_API_KEY=

# Optional default ElevenLabs model, e.g. eleven_multilingual_v2.
ELEVENLABS_DEFAULT_MODEL_ID=

# Optional baseline lifetime of signed media URLs in seconds (default 7200, clamped to 900–43200).
# Longer tracks automatically get longer-lived URLs.
MEDIA_URL_TTL_SECONDS=

# Optional HMAC secret for upload tokens, at least 32 characters (e.g. `openssl rand -base64 48`).
# When empty, a key is derived from SUPABASE_SECRET_KEY.
UPLOAD_TOKEN_SECRET=

# --- Client IP for rate limits (server only, optional) ------------------------
# Per-IP limits (sign-in, password reset, access requests) need the visitor's real IP address. Clients
# can send their own X-Forwarded-For, so tell the app which value your own infrastructure wrote.
# Nothing needed on Vercel: x-vercel-forwarded-for is used automatically (VERCEL is set there).
# Leave both empty and the IP is treated as untrusted: per-IP limits are best-effort, while global caps
# (30 access requests and 60 reset emails per hour across all visitors) still apply. A malformed value
# is logged and ignored. The app must not be reachable except through the proxy/edge described here;
# requests that arrive without the configured header or hops all share one "unknown" bucket.
#
# A header that your edge proxy OVERWRITES with the client IP (it must never pass on a client's own
# value), e.g. x-real-ip (nginx: proxy_set_header X-Real-IP $remote_addr;), cf-connecting-ip
# (Cloudflare), fly-client-ip (Fly.io). Takes precedence over TRUSTED_PROXY_HOPS.
# CLIENT_IP_HEADER=
#
# Number of trusted proxies in front of the app that APPEND to X-Forwarded-For (0-10). The client IP
# is the entry that many positions from the right; entries further left came from the client and are
# ignored. Example: one nginx with proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for; => 1.
# 0 means `next start` is reached directly: the value is then still untrusted.
# TRUSTED_PROXY_HOPS=

# --- Database migrations only (npm run db:migrate; never used by the app) ----

# The database password chosen when creating the Supabase project. The host is found automatically.
# SUPABASE_DB_PASSWORD=
# Optional: region of the project's session pooler, tried first (e.g. eu-west-1).
# SUPABASE_DB_REGION=
# Optional: a full Postgres connection string instead (Dashboard -> Connect -> Session pooler).
# SUPABASE_DB_URL=
